# ==============================================
# LollyPOS - Variables d'environnement requises
# ==============================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# Supabase (obligatoire)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# Backend API (obligatoire)
NEXT_PUBLIC_API_URL=https://lollypos-backend.onrender.com
NEXT_PUBLIC_SITE_URL=https://admin.lolly.sn

# WhatsApp - numéro de contact pour le partage de factures
NEXT_PUBLIC_WHATSAPP_NUMBER=221772354747

# n8n - URL webhook par défaut pour l'export de rapports
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# ID de la boutique Trésorerie (adapte l'interface Ma Caisse)
NEXT_PUBLIC_TREASURY_SHOP_ID=3

# Webhook proxy - domaines autorisés, séparés par des virgules
WEBHOOK_ALLOWED_HOSTS=n8n.srv812544.hstgr.cloud

# Debug (optionnel)
# DEBUG_LOG_PATH=/tmp/lollypos_debug_server.log
