# LOLLY Shop e-commerce (Next.js)
# Copy to .env.local and fill with real local/dev values. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_API_URL=http://127.0.0.1:3005
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional hostname-to-shop override used by lib/resolve-shop.ts.
# Keep this as JSON. Example maps local/custom hosts to shop slugs.
SHOP_HOST_MAP={"luxya.localhost":"luxya","hometek.localhost":"homtek","lollyshop.localhost":"lollyshop"}
